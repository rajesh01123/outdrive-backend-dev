NODE_ENV=development
PORT=3113
API_PREFIX=/api/v1
APP_URL=http://localhost:3113

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outdrive
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d
OTP_TOKEN_SECRET=replace-with-a-different-long-random-secret
OTP_TOKEN_EXPIRES_IN=10m
ADMIN_JWT_SECRET=replace-with-a-third-long-random-secret
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_LOGIN_CHALLENGE_EXPIRES_IN=5m
ADMIN_OTP_EXPIRY_SECONDS=300
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_DEV_OTP=123456

OTP_EXPIRY_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_DAILY_CAP=10
DEV_FIXED_OTP=123456

# Keep false until a payment gateway is integrated; ETA then hides "online".
ONLINE_PAYMENT_ENABLED=false
